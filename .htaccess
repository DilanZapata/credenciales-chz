# ---------------------------------------------------------------------
#  Enrutado (patron de Porcify Manager)
#
#     /credenciales      ->  index.php?views=credenciales
#     /credenciales/12   ->  index.php?views=credenciales/12
#
#  A diferencia de la referencia, aqui el arbol interno NO queda expuesto:
#  este sistema guarda secretos y su codigo no debe poder descargarse.
# ---------------------------------------------------------------------
RewriteEngine On
Options All -Indexes

# Los assets se sirven directamente; el resto va al controlador frontal.
RewriteRule ^([a-zA-Z0-9/ñÑ_-]+)$ index.php?views=$1 [QSA,L]

# ------------------- Proteccion del arbol interno --------------------
# Solo son alcanzables index.php, los endpoints de app/api/ y los assets
# de app/views/{css,js,img}. Todo lo demas queda denegado.
<FilesMatch "(^\.|\.(env|sql|log|md|json|lock|ini|bak|sqlite|yml|yaml|xlsx|xls|csv)$)">
    Require all denied
</FilesMatch>

# En la raiz solo se sirve el controlador frontal. El autocargador se
# incluye desde PHP y no tiene por que ser alcanzable por la red.
# (La regla va por nombre: un FilesMatch generico sobre *.php se heredaria
#  en app/api/ y dejaria los endpoints fuera de servicio.)
<Files "autoload.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header unset X-Powered-By
    Header always unset Server
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>
