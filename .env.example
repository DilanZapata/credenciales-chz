# =====================================================================
#  Sistema Corporativo de Gestion de Credenciales - configuracion
#
#  ESTE ARCHIVO NUNCA DEBE SER ACCESIBLE POR HTTP NI SUBIRSE A UN
#  REPOSITORIO. Permisos recomendados: 0600, propietario del servicio web.
# =====================================================================

APP_NAME="Sistema Corporativo de Gestion de Credenciales"
APP_SHORT_NAME="Credenciales"
APP_ORGANIZATION="Mi Empresa"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/credencial
APP_BASE_PATH=/credencial
APP_TIMEZONE=America/Bogota

# Solo si el sistema se sirve detras de un proxy inverso de confianza.
APP_TRUST_PROXY=false

# ---------------------------------------------------------------------
#  CLAVE MAESTRA DE CIFRADO
#  Generela con:  php bin/console.php key:generate
#  32 bytes aleatorios en base64. SIN ELLA LOS SECRETOS SON IRRECUPERABLES.
#  Guarde una copia en un lugar seguro y fuera del servidor.
# ---------------------------------------------------------------------
APP_MASTER_KEY=
APP_PEPPER=

# ---------------------------------------------------------------------
#  Base de datos
# ---------------------------------------------------------------------
# Los paneles de despliegue entregan la conexion en una sola URL. Si
# define DATABASE_URL puede omitir las cinco variables siguientes.
# DATABASE_URL=mysql://usuario:clave@servidor:3306/credenciales_corp

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=credenciales_corp
DB_USERNAME=root
DB_PASSWORD=
# Ruta al socket unix (opcional; en XAMPP para macOS suele ser necesaria)
DB_SOCKET=

# ---------------------------------------------------------------------
#  Sesiones
#  Active SESSION_SECURE en cuanto el sistema se sirva por HTTPS.
# ---------------------------------------------------------------------
SESSION_SECURE=false
SESSION_SAMESITE=Strict

# ---------------------------------------------------------------------
#  CORS: deshabilitado por defecto (el frontend comparte origen).
# ---------------------------------------------------------------------
CORS_ENABLED=false
CORS_ORIGINS=
